// Sitio estático de la versión web (web/) + API de sincronización (worker/index.js) con un KV.
// Deploy: `npx wrangler deploy`. El KV "ESPACIOS" se crea solo en el primer deploy (no hace falta pegar ningún id).
// El nombre tiene que coincidir con el del proyecto en Cloudflare (rut1nas).
{
  "name": "rut1nas",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./web",
    // Solo /api/* pasa por el Worker; todo lo demás se sirve como archivo estático, sin costo de ejecución.
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "ESPACIOS" }]
}
